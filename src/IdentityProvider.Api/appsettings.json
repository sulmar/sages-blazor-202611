{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Cors": {
    "Origins": [ "https://localhost:7034" ]
  },

  "JwtSettings": {
    "SecretKey": "a-string-secret-at-least-256-bits-long",
    "Issuer": "https://domain.pl",
    "Audience": "https://example.com",
    "ExpiresMinutes": 30
  }

}
