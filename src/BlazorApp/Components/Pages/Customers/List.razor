@page "/customers" 
@using BlazorApp.Shared
@inject ICustomerRepository Repository

<h3>Customer List</h3>

<Loader Data="customers" Context="customers">

	<DataTable Items="customers" Context="customer">

		<Header>
			<th>Id</th>
			<th>Name</th>
			<th>Email</th>
		</Header>

		<Row>
			<td>@customer.Id</td>
			<td>@customer.Name</td>
			<td>@customer.Email</td>
		</Row>

		<Footer>
			<td colspan="3">Count: @customers.Count()</td>
		</Footer>

	</DataTable>
</Loader>

