@page "/customers" 
@using BlazorApp.Services
@using Microsoft.AspNetCore.Authorization
@inject ICustomerRepository Repository
@inject NavigationManager Navigation
@inject DialogService Dialog
@attribute [Authorize]

<h3>Customer List</h3>


<a class="btn btn-primary" href="customers/create">Dodaj klienta</a>

<SearchPanel TextChanged="Search" />


<Loader Data="customers" Context="customers">
	<CustomerTable customers="customers" OnDelete="Delete" />	
</Loader>

@code {


    private void Search(string text)
    {
        Console.WriteLine($"Search customers by {text}");
    }

    private IEnumerable<Customer>? customers;

    protected override async Task OnInitializedAsync()
    {
        customers = await Repository.GetAllAsync();
    }

    private async Task Delete(Customer customer)
    {
        bool confirmed = await Dialog.ConfirmAsync($"Czy chcesz usunąć klienta {customer.Name}?");

        if (confirmed)
        {
            await Repository.DeleteAsync(customer.Id);
        }
        
        customers = await Repository.GetAllAsync();
        Navigation.NavigateTo("customers");
        

    }


}
