@page "/customers" 
@inject ICustomerRepository Repository

<h3>Customer List</h3>

<div class="input-group">    
    <input type="search" class="form-control" placeholder="Szukaj..." @bind="text" @bind:event="oninput" @bind:after="Search" />
    <button class="btn btn-outline-primary" type="button" @onclick="Search">Szukaj</button>
</div>


<Loader Data="customers" Context="customers">
	<CustomerTable customers="customers" />	
</Loader>

@code {

    private string? text { get; set; } = "a";

	private void Search()
	{
		Console.WriteLine($"Search customers by {text}");
	}

    private IEnumerable<Customer>? customers;

    protected override async Task OnInitializedAsync()
    {
        customers = await Repository.GetAllAsync();
    }
}
