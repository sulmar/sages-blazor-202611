@page "/customers" 
@using BlazorApp.Shared
@inject ICustomerRepository Repository

<h3>Customer List</h3>

<Loader Data="customers" Context="customers">
	<ul>
		@foreach (Customer customer in customers!)
		{
			<li>@customer.Id @customer.Name @customer.Email</li>
		}
	</ul>
</Loader>


@code {

	// [Inject]
	// private ICustomerRepository Repository { get; set; }

	private IEnumerable<Customer>? customers;

	protected override async Task OnInitializedAsync()
	{
		customers = await Repository.GetAllAsync();
	}


}
