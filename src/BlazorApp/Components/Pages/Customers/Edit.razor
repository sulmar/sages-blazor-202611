@page "/customers/{Id:int}/edit"
@inject ICustomerRepository Repository
@inject NavigationManager Navigation

<h3>Edit Customer @Id</h3>

<Loader Data="@customer">

	@* <form method="post">

		<AntiforgeryToken />

		<input type="hidden" name="id" value="@customer.Id" />
		<input type="text" id="firstname" name="name" value="abc" />
		<input type="email" id="email" name="email" value="a@b.com" />
		<button type="submit" class="btn btn-primary">Zapisz</button>
	</form>  *@

	
	<CustomerForm Customer="@customer" OnSave="@OnSave" />
	
</Loader>

@code {

	[Parameter]
	public int Id { get; set; }

	private Customer? customer;

	protected override async Task OnParametersSetAsync()
	{
		customer = await Repository.GetByIdAsync(Id);

		// editContext = new EditContext(customer);

		// editContext.OnValidationRequested += ValidationRequest;
	}

	// private EditContext editContext = default!;

	// private void ValidationRequest(object? sender, ValidationRequestedEventArgs e)
	// {

	// }


	private async Task OnSave()
	{
		await Repository.UpdateAsync(customer);

		Navigation.NavigateTo("/customers");		
	}

}
