@page "/customers/create"
@inject ICustomerRepository Repository
@inject NavigationManager Navigation


<h3>Create</h3>

<CustomerForm Customer="@customer" OnSave="@OnSave">
	<AdditionalFields Context="model">
		<label>Telefon</label>
		<InputText @bind-Value="model.Phone" />
		<ValidationMessage For="() => model.Phone" />
	</AdditionalFields>
</CustomerForm>

@code {

	private Customer customer = new Customer { Name = string.Empty, Email = string.Empty };

	private async Task OnSave()
	{
		await Repository.AddAsync(customer);

		Navigation.NavigateTo("/customers");
	}
}
