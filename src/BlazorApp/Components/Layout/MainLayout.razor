@inherits LayoutComponentBase

<div class="page">
	<div class="sidebar">
		<NavMenu />
	</div>

	<main>



		<div class="top-row px-4">

			<button class="btn btn-@theme" @onclick="ToggleTheme">Zmień motyw - aktualnie: @theme</button>

			<button class="btn btn-outline-secondary" @onclick="@(() => startNumber++)">Strona +1</button>
			<button class="btn btn-outline-secondary" @onclick="@(() => startNumber--)">Strona -1</button>

			<a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
		</div>

		<CascadingValue Value="@theme">
			
		@* 	<PagingProvider pageSize="5" startNumber="@startNumber"> *@
					
				<article class="content px-4">
					@Body
				</article>

			@* </PagingProvider> *@
		
		</CascadingValue>



	</main>
</div>

<div id="blazor-error-ui" data-nosnippet>
	An unhandled error has occurred.
	<a href="." class="reload">Reload</a>
	<span class="dismiss">🗙</span>
</div>

@code {


	private string theme = "Light";

	private void ToggleTheme()
	{
		theme = theme == "light" ? "dark" : "light";
	}
	

	private int startNumber = 2;
}
