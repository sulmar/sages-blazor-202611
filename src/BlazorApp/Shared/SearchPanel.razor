@using BlazorApp.Services
@implements IDisposable

<div class="input-group">
    <input @ref="input"
           type="search"
           class="form-control"
           placeholder="Szukaj..."
           @bind-value="inputText"
           @bind-value:event="oninput"
           @bind-value:after="OnTextChangedAsync" />

    <button class="btn btn-outline-primary"
            type="button"
            @onclick="Search">
        Szukaj
    </button>

    <button class="btn btn-outline-secondary"
            type="button"
            @onclick="Clear">
        Wyczyść
    </button>
</div>

@code {
    private ElementReference input;
    private readonly Debouncer debouncer = new();
    private string inputText = string.Empty;

    [Parameter]
    public int DebounceMiliseconds { get; set; } = 300;

    [Parameter]
    public EventCallback<string> TextChanged { get; set; }

    private Task OnTextChangedAsync()
    {
        return NotifyAfterAsync(DebounceMiliseconds);
    }

    private Task Search()
    {
        return NotifyAfterAsync(0);
    }

    private Task NotifyAfterAsync(int milliseconds)
    {
        var text = inputText;

        return debouncer.DebounceAsync(milliseconds, async token =>
        {
            token.ThrowIfCancellationRequested();
            await TextChanged.InvokeAsync(text);
        });
    }

    private async Task Clear()
    {
        inputText = string.Empty;
        await Search();
        await input.FocusAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await input.FocusAsync();
        }
    }

    public void Dispose()
    {
        debouncer.Dispose();
    }
}