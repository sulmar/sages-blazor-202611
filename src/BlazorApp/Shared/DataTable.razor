@typeparam TItem


<table class="table table-striped align-middle table-@Theme">
	<thead>
		<tr>
			@Header
		</tr>
	</thead>

	<tbody>

		@foreach (var item in Items)
		{
			<tr>@Row(item)</tr>
		}
	</tbody>

	@if (Footer is not null)
	{
		<tfoot>
			<tr>@Footer</tr>
		</tfoot>
	}
</table>


@code {

	[Parameter]
	public required IEnumerable<TItem> Items { get; set; }

	[Parameter]
	public required RenderFragment Header { get; set; }

	[Parameter]
	public required RenderFragment<TItem> Row { get; set; }

	[Parameter]
	public RenderFragment? Footer { get; set; }

	[CascadingParameter]
	public string Theme { get; set; }

}
